# Copy to .env and fill in. Real environment variables take precedence over this file.

# Required: OpenAI API key
OPENAI_API_KEY=

# Optional: model name (default gpt-4.1). Any chat model that supports function calling works.
OPENAI_MODEL=

# Optional: OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, Ollama, ...). Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Optional: request timeout in seconds (default 120) and sampling temperature (unset = model default)
OPENAI_TIMEOUT=
OPENAI_TEMPERATURE=

# Optional: maximum agent tool rounds (default 40)
AGENT_MAX_STEPS=
